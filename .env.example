# Required: password for the bundled PostgreSQL database. Any characters are fine
# (write a literal $ as $$). It is set when the database is first created.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
# Port Printrio listens on, inside the container and on the host (e.g. 8080 → 8080:8080).
PRINTRIO_PORT=3000
# Set to true when Printrio is served over HTTPS (reverse proxy, Tailscale Serve, …).
COOKIE_SECURE=false
# Printrio version to run: latest (default), a release such as 1.2.0, or edge (newest from main).
# PRINTRIO_VERSION=latest
